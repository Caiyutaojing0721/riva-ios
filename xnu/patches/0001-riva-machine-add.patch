diff --git a/pexpert/pexpert/arm64/RIVA.h b/pexpert/pexpert/arm64/RIVA.h
new file mode 100644
index 0000000..0360357
--- /dev/null
+++ b/pexpert/pexpert/arm64/RIVA.h
@@ -0,0 +1,21 @@
+/* Board config for the Xiaomi Redmi 5A (riva, MSM8917/8940). */
+#ifndef _PEXPERT_ARM64_RIVA_H
+#define _PEXPERT_ARM64_RIVA_H
+#define NO_MONITOR 1
+#define NO_ECORE 1
+#define RIVA 1
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__ 8
+#define __ARM_VMSA__ 8
+#define __ARM_VFP__ 4
+#define __ARM_COHERENT_CACHE__ 1
+#define __ARM_DEBUG__ 7
+#define __ARM_ENABLE_SWAP__ 1
+#define __ARM_16K_PG__ 0
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 0
+#define __ARM_PAN_AVAILABLE__ 0
+#define HAS_GIC_V3 0
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif
+#endif
