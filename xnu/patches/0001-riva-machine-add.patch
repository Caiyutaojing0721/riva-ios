diff --git a/config/MASTER.arm64.riva b/config/MASTER.arm64.riva
new file mode 100644
index 0000000..bce018d
--- /dev/null
+++ b/config/MASTER.arm64.riva
@@ -0,0 +1,4 @@
+# riva bring-up config
+MACHINE_CONFIG = RIVA
+KERNEL_CONFIG = DEVELOPMENT
+arm64_ARCH_CONFIG = nos_arm_asm nos_arm_pmap
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index bc8bed8..19665ac 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -2,7 +2,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET
+SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET RIVA
 
 endif
 
@@ -12,6 +12,7 @@ MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+MACHINE_FLAGS_ARM64_RIVA = -DARM64_BOARD_CONFIG_RIVA                  -march=armv8-a
 
 
 #
@@ -22,8 +23,10 @@ export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CON
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
 # sweet/riva's Cortex-A53/A55 have no pointer authentication: stay plain arm64
 ifneq ($(CURRENT_MACHINE_CONFIG),SWEET)
+ifneq ($(CURRENT_MACHINE_CONFIG),RIVA)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
+endif
 
 endif
 
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index 101d9ff..29d13ab 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -1,6 +1,14 @@
 /* D-Cache. */
 #define MMU_CLINE   6
 
+#elif defined (RIVA)  /* Qualcomm MSM8917/8940: Cortex-A53 */
+
+/* I-Cache. */
+#define MMU_I_CLINE 6
+
+/* D-Cache. */
+#define MMU_CLINE   6
+
 #elif defined (SWEET) /* Qualcomm Kryo 470: Cortex-A76 + Cortex-A55 */
 
 /* I-Cache. */
