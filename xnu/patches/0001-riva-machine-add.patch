diff --git a/config/MASTER.arm64.riva b/config/MASTER.arm64.riva
new file mode 100644
index 0000000..bbcb4ca
--- /dev/null
+++ b/config/MASTER.arm64.riva
@@ -0,0 +1,15 @@
+# riva (Redmi 5A, MSM8917/8940) bring-up config
+MACHINE_CONFIG = RIVA
+KERNEL_CONFIG = DEVELOPMENT
+arm64_ARCH_CONFIG = nos_arm_asm nos_arm_pmap
+
+CONFIG_HIBERNATION = 1
+CONFIG_PREEMPTION = 0
+CONFIG_FEATURES = std
+
+# No PAC, no 16K pages, GICv2-only SoC
+CONFIG_ARM64_PAC = 0
+CONFIG_ARM64_16K = 1
+
+CONFIG_KERNEL_INTEGRITY = 0
+CONFIG_CSR = 0
