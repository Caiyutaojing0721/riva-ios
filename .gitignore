# ---- macOS / XNU build artifacts (from CI "buildtree" + local compiles) ----
*.o
*.a
*.dSYM
*.unstripped
*.cpo
buildtree.tgz
dxb/
build/
fakeroot/
SDKROOT/

# The xnu build toolchain checks out the xnu SOURCE into ./xnu at build time.
# We must NOT ignore xnu/patches/ (that's our committed patch series!), so
# ignore the checked-out source tree explicitly instead of the whole xnu/ dir.
/xnu/external/
/xnu/osfmk/
/xnu/bsd/
/xnu/iokit/
/xnu/config/
/xnu/makedefs/
/xnu/pexpert/
/xnu/SETUP/
/xnu/Makefile
/xnu/EXTERNAL_HEADERS/

# ---- Python ----
__pycache__/
*.pyc

# ---- payload / image outputs (large binaries, generated) ----
*.bin
*.img
*.simg
payload.bin
out/
shim/out/

# ---- git-generated tools once you push to GitHub ----
.DS_Store

# ---- editor / os noise ----
*.swp
*~